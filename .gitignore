settings.json
window.json
app.log
*.log
webview/

# Local test and scratch folders
scratch/
scratchpad/
tmp/
test-data/
md[0-9]*/
appdata*/
srv[0-9]*/

# Tool and editor state
.claude/
.playwright-mcp/
.vscode/
.idea/
